{
  "name": "mipi",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && vite build",
    "clean": "shx rm -rf .wrangler dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && oxlint --deny-warnings && node scripts/stamp-version.ts --check && node scripts/ledger-cli.ts --check && node scripts/check-boundaries.ts && wrangler types --env-file .dev.vars.example --include-runtime false --check && tsc && tsc -p tsconfig.client.json && tsc -p tsconfig.scripts.json && node scripts/dry-run.ts",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest --run",
    "eval:proactive": "node scripts/eval-proactive.ts",
    "changeset": "changeset",
    "lint": "oxlint --deny-warnings",
    "upgrade:pi": "node scripts/upgrade-pi.ts",
    "ledger": "node scripts/ledger-cli.ts",
    "bump": "changeset version && node scripts/stamp-version.ts",
    "fixture:capture": "node scripts/fixture-capture.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@earendil-works/pi-schema": "1.6.1",
    "partysocket": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "shx": "0.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.15.1"
}
