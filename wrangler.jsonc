{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mipi",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT",
        "class_name": "MipiAgent",
      },
    ],
  },
  "exports": {
    "MipiAgent": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // The one person this agent belongs to: names the single session (Durable Object) everything lives in.
    "MIPI_OWNER": "jerome",
    // Which lane this Worker is: "production" here, "staging" in env.staging.
    "MIPI_ENV": "production",
    // OpenCode Go model id for new conversations.
    "MIPI_MODEL": "deepseek-v4.1-flash",
    // The owner's time zone: every message is stamped with its local time.
    "MIPI_TIMEZONE": "America/Chicago",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "env": {
    // Staging lane: its own Worker (mipi-staging), its own Durable Object storage, its own secrets. Every push to
    // main lands here first; production deploys are by hand, after a backup.
    "staging": {
      "name": "mipi-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "AGENT",
            "class_name": "MipiAgent",
          },
        ],
      },
      "vars": {
        "MIPI_OWNER": "jerome",
        "MIPI_ENV": "staging",
        "MIPI_MODEL": "deepseek-v4.1-flash",
        "MIPI_TIMEZONE": "America/Chicago",
      },
    },
  },
}
