OPENCODE_API_KEY=
# Optional (M9): an OpenCode key with usage permission, for the usage readout, when OPENCODE_API_KEY has none. And the
# OpenCode workspace id, if Go's usage endpoint asks for one.
OPENCODE_USAGE_KEY=
OPENCODE_ORG_ID=
# The M1 spike lock, used until Cloudflare Access is on: a long random string.
MIPI_SPIKE_TOKEN=
# Deploy scripts' token for admin routes, used until Cloudflare Access is on.
ADMIN_TOKEN=
# Cloudflare Access (M4). Set both to turn Access on: every web route then needs an Access JWT, and admin routes the
# deploy service token. Deployed lanes get them from the GitHub Environment's variables; leave them empty locally.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# The deploy service token's client id (the JWT's common_name), accepted on admin routes only.
ACCESS_SERVICE_CLIENT_ID=
# Local development only: 1 skips all auth on localhost. Any other host refuses every request while it is set.
MIPI_ACCESS_SKIP=
# Telegram (M5). The bot's token from @BotFather, and the webhook secret Telegram sends back on every update
# (1–256 of A–Z, a–z, 0–9, _ and -). Without a valid secret the webhook refuses everything.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ids allowed to talk to the agent, separated by commas. Empty: nobody.
TELEGRAM_ALLOWED_USER_IDS=
# This lane's bot username, without @, so "/model@<bot>" is recognised and commands for other bots are ignored.
TELEGRAM_BOT_USERNAME=
# PiDu relay (M7): the bearer token PiDu sends to /api/relay (24+ random characters). Empty: the relay is off.
RELAY_TOKEN=
# Only while rotating RELAY_TOKEN: the old token, still accepted until PiDu has the new one.
RELAY_TOKEN_PREVIOUS=
# The vault (COD-255): 32 random bytes, base64, that wrap this lane's bot-secret data key. Make one with
# node -e "console.log(crypto.randomBytes(32).toString('base64'))". Empty or "off": the vault stays locked.
MIPI_VAULT_KEY=
# Only while rotating MIPI_VAULT_KEY: the old key, so the agent can rewrap the data key with the new one.
MIPI_VAULT_KEY_PREVIOUS=
